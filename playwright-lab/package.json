{
  "name": "playwright-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Palestra per imparare Playwright: un piccolo sito locale e test commentati in italiano",
  "scripts": {
    "sito": "node server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:4173"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
